import unittest
from unittest.mock import patch
from io import BytesIO

from openpyxl import load_workbook

from resources.retrieve_fees_data.fee_excel_generator import FeeExcelGenerator


FAKE_BASE_COLUMNS = [
    ("Umbrella name", "umbrella_name"),
    ("ISIN code", "isin_code"),
]

FAKE_EXCEL_SECTIONS = [
    {
        "title": "Management fees",
        "color": "4472C4",
        "subsections": [
            {
                "subtitle": "Rate",
                "columns": [
                    ("Max Rate", "mgmt_max_rate"),
                    ("Real Rate", "mgmt_real_rate"),
                ],
            },
        ],
    },
    {
        "title": "Charity fees",
        "color": "70AD47",
        "subsections": [
            {
                "subtitle": "Max",
                "columns": [("Max Rate", "charity_max_rate")],
            },
            {
                "subtitle": "Real",
                "columns": [("Real Rate", "charity_real_rate")],
            },
        ],
    },
]


class TestFeeExcelGenerator(unittest.TestCase):
    """Couvre generate/_write_headers/_write_data/_apply_column_widths de FeeExcelGenerator"""

    @classmethod
    def setUpClass(cls):
        # Patch des constantes de layout pour garantir des sections à colonne
        # unique ET à colonnes multiples, quel que soit le contenu métier réel
        # de constants/excel_layout_config.py -> déclenche les deux blocs
        # merge_cells conditionnels (subsection et section).
        cls.base_columns_patcher = patch(
            "resources.retrieve_fees_data.fee_excel_generator.BASE_COLUMNS",
            FAKE_BASE_COLUMNS,
        )
        cls.sections_patcher = patch(
            "resources.retrieve_fees_data.fee_excel_generator.EXCEL_SECTIONS",
            FAKE_EXCEL_SECTIONS,
        )
        cls.color_base_patcher = patch(
            "resources.retrieve_fees_data.fee_excel_generator.COLOR_BASE",
            "D9D9D9",
        )
        cls.base_columns_patcher.start()
        cls.sections_patcher.start()
        cls.color_base_patcher.start()

    @classmethod
    def tearDownClass(cls):
        cls.base_columns_patcher.stop()
        cls.sections_patcher.stop()
        cls.color_base_patcher.stop()

    def test_generate_returns_bytesio_workbook(self):
        """generate() doit renvoyer un BytesIO chargeable par openpyxl"""
        rows = [
            {
                "umbrella_name": "Umbrella A",
                "isin_code": "FR0000000001",
                "mgmt_max_rate": "1.50",
                "mgmt_real_rate": "1.20",
                "charity_max_rate": "0.10",
                "charity_real_rate": "0.05",
            },
            {
                "umbrella_name": "Umbrella B",
                "isin_code": "FR0000000002",
                "mgmt_max_rate": "2.00",
                "mgmt_real_rate": "1.80",
                "charity_max_rate": "0.20",
                "charity_real_rate": "0.15",
            },
        ]

        buffer = FeeExcelGenerator.generate(rows)

        self.assertIsInstance(buffer, BytesIO)
        wb = load_workbook(buffer)
        ws = wb.active
        self.assertEqual(ws.title, "Fees Review")
        self.assertEqual(ws.freeze_panes, "A4")

    def test_generate_with_empty_rows(self):
        """generate() doit fonctionner même sans lignes de données (headers seuls)"""
        buffer = FeeExcelGenerator.generate([])
        wb = load_workbook(buffer)
        ws = wb.active
        # Headers écrits (ligne 3 = COLUMN_LABEL_ROW), pas de données ligne 4
        self.assertEqual(ws.cell(row=3, column=1).value, "Umbrella name")
        self.assertIsNone(ws.cell(row=4, column=1).value)

    def test_write_headers_base_columns(self):
        """Les colonnes de base doivent être fusionnées sur 3 lignes et stylées"""
        wb = load_workbook(FeeExcelGenerator.generate([]))
        ws = wb.active

        self.assertEqual(ws.cell(row=1, column=1).value, "Umbrella name")
        self.assertEqual(ws.cell(row=1, column=2).value, "ISIN code")
        # Vérifie la fusion verticale (row 1 à 3) sur la 1ère colonne de base
        merged_ranges = [str(r) for r in ws.merged_cells.ranges]
        self.assertIn("A1:A3", merged_ranges)

    def test_write_headers_subsection_merge_multi_column(self):
        """Une sous-section à plusieurs colonnes doit fusionner son titre (branche col-1 > subsection_start_col)"""
        wb = load_workbook(FeeExcelGenerator.generate([]))
        ws = wb.active

        # "Rate" (Management) couvre 2 colonnes -> titre fusionné en ligne 2
        merged_ranges = [str(r) for r in ws.merged_cells.ranges]
        # Colonnes de base = 2 (A,B), donc Management/Rate commence en C
        self.assertIn("C2:D2", merged_ranges)
        self.assertEqual(ws.cell(row=2, column=3).value, "Rate")

    def test_write_headers_subsection_single_column_no_merge(self):
        """Une sous-section à une seule colonne ne doit pas déclencher de fusion (branche col-1 == subsection_start_col)"""
        wb = load_workbook(FeeExcelGenerator.generate([]))
        ws = wb.active

        # "Max" (Charity) n'a qu'une colonne -> pas de fusion, mais le titre est bien écrit
        merged_ranges = [str(r) for r in ws.merged_cells.ranges]
        self.assertNotIn("E2:E2", merged_ranges)
        self.assertEqual(ws.cell(row=2, column=5).value, "Max")

    def test_write_headers_section_merge_multi_subsection(self):
        """Une section à plusieurs colonnes (via plusieurs sous-sections) doit fusionner son titre (branche section)"""
        wb = load_workbook(FeeExcelGenerator.generate([]))
        ws = wb.active

        merged_ranges = [str(r) for r in ws.merged_cells.ranges]
        # Charity fees = colonnes E et F (Max + Real) -> titre fusionné ligne 1
        self.assertIn("E1:F1", merged_ranges)
        self.assertEqual(ws.cell(row=1, column=5).value, "Charity fees")

    def test_write_data_maps_rows_to_correct_columns(self):
        """_write_data doit placer chaque valeur dans la bonne colonne selon col_index"""
        rows = [
            {
                "umbrella_name": "Umbrella A",
                "isin_code": "FR0000000001",
                "mgmt_max_rate": "1.50",
                "mgmt_real_rate": "1.20",
                "charity_max_rate": "0.10",
                "charity_real_rate": "0.05",
            }
        ]
        wb = load_workbook(FeeExcelGenerator.generate(rows))
        ws = wb.active

        self.assertEqual(ws.cell(row=4, column=1).value, "Umbrella A")
        self.assertEqual(ws.cell(row=4, column=2).value, "FR0000000001")
        self.assertEqual(ws.cell(row=4, column=3).value, "1.50")

    def test_write_data_missing_key_defaults_to_none(self):
        """Une clé absente du dict de la ligne doit donner une cellule vide (row_data.get)"""
        rows = [{"umbrella_name": "Umbrella A"}]  # colonnes fees absentes
        wb = load_workbook(FeeExcelGenerator.generate(rows))
        ws = wb.active

        self.assertEqual(ws.cell(row=4, column=1).value, "Umbrella A")
        self.assertIsNone(ws.cell(row=4, column=3).value)

    def test_apply_column_widths_sets_fixed_width(self):
        """Toutes les colonnes doivent recevoir une largeur fixe de 16"""
        wb = load_workbook(FeeExcelGenerator.generate([]))
        ws = wb.active

        # 2 colonnes de base + 2 (Management/Rate) + 1 (Charity/Max) + 1 (Charity/Real) = 6
        for col_letter in ["A", "B", "C", "D", "E", "F"]:
            self.assertEqual(ws.column_dimensions[col_letter].width, 16)
